---
/**
 * «Which version should you use?» — the release status band (audit H8, V2).
 * Everything here is read from the manifest: states, dates, Blender pins,
 * the EM Tools and EMStudio versions. The line under the cards names the
 * sources and the build time.
 */
import { manifesto, meseAnno } from '../lib/releases';
import SupportTimeline from './SupportTimeline.astro';
import { getCollection } from 'astro:content';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = await manifesto();
const order = ['recommended', 'dev', 'legacy'];
const lines = m.lines.filter((l) => order.includes(l.state)).sort((a, b) => order.indexOf(a.state) - order.indexOf(b.state));
const v = (l: typeof lines[number], slug: string) => l.components.find((c) => c.slug === slug)?.version;
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const plan = new Map((await getCollection('versions')).map((x) => [x.data.version, (x.data.milestones ?? []).filter((m) => +m.date > Date.now())]));
const built = new Date(m.built).toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
---
<section class="band">
  <div class="container">
    <span class="tag band__tag">Release status</span>
    <h2>Which version should you use?</h2>
    <p class="band__sub">Two lines are supported at any time. This band is rebuilt from the release manifest each time a tool is published.</p>
    <div class="band__lines">
      {lines.map((l) => (
        <div class={`ln ln--${l.state}`}>
          <div class="ln__h"><b>EM {l.version}</b><span class={`st st--${l.state}`}>{l.label}</span></div>
          <p>{l.summary}</p>
          <dl>
            <dt>Blender</dt><dd>{l.blenderLts ? `${l.blenderLts} LTS` : l.blenderMin ? `${l.blenderMin}+` : '—'}</dd>
            {l.eolDate && <><dt>Supported to</dt><dd>{meseAnno(l.eolDate)}</dd></>}
            {(plan.get(l.version) ?? []).map((ms) => <><dt>{ms.phase[0].toUpperCase() + ms.phase.slice(1)}</dt><dd>{fmt(ms.date)}{ms.note && <small> · {ms.note}</small>}</dd></>)}
            {v(l, 'em-tools') && <><dt>EM Tools</dt><dd>{v(l, 'em-tools')}</dd></>}
            {v(l, 'emstudio') && <><dt>EMStudio</dt><dd>{v(l, 'emstudio')}</dd></>}
          </dl>
          <a href={`${B}/download/?line=${l.slug}`}>{l.state === 'dev' ? `Try ${l.version}` : `Get ${l.version}`} <span aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>
    <div class="band__tl"><SupportTimeline variant="band" /></div>
    <p class="band__src">
      <b class="band__srch">Versions read from</b><span>Blender extension repository</span><span>PyPI</span><span>GitHub Releases</span><span>built {built}</span>
      <a href={`${B}/status.json`} title="The same version data as JSON: the manuals' version banner and EMStudio's update check read this file">Machine-readable feed (status.json)</a>
    </p>
  </div>
</section>
<style>
  .band { background: var(--em-navy-fill); color: #eef3f9; padding: clamp(56px, 7vw, 88px) 0; }
  .band h2 { color: #ffffff; font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .band__tag { color: #e3b43a; }
  .band__tag::before { background: #e3b43a; }
  .band__sub { color: #b9cbe0; margin-top: 12px; max-width: 62ch; }
  .band__lines { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 32px; }
  @media (max-width: 860px) { .band__lines { grid-template-columns: minmax(0, 1fr); } }
  .ln { border: 1px solid rgba(255, 255, 255, 0.16); border-radius: var(--radius-lg); padding: 20px; display: grid; gap: 10px; align-content: start; background: rgba(255, 255, 255, 0.03); }
  .ln--recommended { border-color: #e3b43a; background: rgba(227, 180, 58, 0.07); }
  .ln__h { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .ln__h b { font: 700 1.7rem/1 var(--font-display); color: #ffffff; }
  .st { font: 600 0.64rem/1 var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase; border-radius: 4px; padding: 5px 7px; }
  .st--recommended { background: #e3b43a; color: #1d1d1b; }
  .st--dev { background: rgba(165, 220, 255, 0.16); color: #a5dcff; }
  .st--legacy { background: rgba(255, 255, 255, 0.1); color: #c9d5e3; }
  .ln p { color: #b9cbe0; font-size: 0.86rem; line-height: 1.6; }
  .ln dl { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; font-size: 0.8rem; }
  .ln dt { color: #b9cbe0; }
  .ln dd { font-family: var(--font-mono); color: #ffffff; }
  .ln a { color: #f1d27c; font-weight: 600; }
  .ln a:hover { color: #ffffff; }
  .band__tl { margin-top: 30px; border-top: 1px solid rgba(255, 255, 255, 0.14); padding-top: 18px; }
  .band__src { margin-top: 14px; font-size: 0.76rem; color: #b9cbe0; display: flex; gap: 6px 16px; flex-wrap: wrap; }
  .band__src span::before { content: "●"; color: #8ee0a4; margin-right: 6px; font-size: 0.6rem; vertical-align: 2px; }
  .band__src a { color: #f1d27c; }
  .band__srch { font-weight: 600; color: #eef3f9; }
</style>
