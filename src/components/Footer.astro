---
/**
 * Footer: four named columns (Learn, Get, Project, Community) instead of a
 * single row of fifteen links (audit H9). Licences and privacy sit in the
 * legal line underneath.
 */
const year = new Date().getFullYear();
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const ext = { target: '_blank', rel: 'noopener' };
---

<footer class="em-footer">
  <div class="em-footer__inner">
    <div class="em-footer__cols">
      <div class="em-footer__about">
        <a href={`${B}/`} class="em-footer__brand" aria-label="Extended Matrix home">
          <svg viewBox="0 0 140 240" width="16" height="27" aria-hidden="true"><use href="#mark" /></svg>
          <span>Extended<span>Matrix</span></span>
        </a>
        <p>A formal language for archaeological reasoning, developed at CNR-ISPC since 2015.</p>
      </div>
      <div>
        <h2>Learn</h2>
        <ul>
          <li><a href={`${B}/start`}>Start here</a></li>
          <li><a href={`${B}/find-your-path`}>Find your path</a></li>
          <li><a href={`${B}/personas`}>Team roles</a></li>
          <li><a href="https://docs.extendedmatrix.org" {...ext}>Language manual ↗</a></li>
        </ul>
      </div>
      <div>
        <h2>Get</h2>
        <ul>
          <li><a href={`${B}/download`}>Download</a></li>
          <li><a href={`${B}/versions`}>All versions</a></li>
          <li><a href={`${B}/tools`}>Tools</a></li>
          <li><a href={`${B}/blender-addons`}>Blender add-ons</a></li>
          <li><a href={`${B}/code`}>Source code</a></li>
        </ul>
      </div>
      <div>
        <h2>Project</h2>
        <ul>
          <li><a href={`${B}/about`}>About</a></li>
          <li><a href={`${B}/team`}>Team</a></li>
          <li><a href={`${B}/projects`}>Projects</a></li>
          <li><a href={`${B}/publications`}>Publications</a></li>
          <li><a href={`${B}/cite`}>How to cite</a></li>
          <li><a href={`${B}/standards`}>Standards</a></li>
        </ul>
      </div>
      <div>
        <h2>Community</h2>
        <ul>
          <li><a href={`${B}/community`}>EM Hour &amp; meetings</a></li>
          <li><a href={`${B}/news`}>News</a></li>
          <li><a href={`${B}/events`}>Events</a></li>
          <li><a href="https://dev.extendedmatrix.org/" {...ext}>Development tracker ↗</a></li>
          <li><a href="https://t.me/UserGroupEM" {...ext}>Telegram ↗</a></li>
          <li><a href="https://zenodo.org/communities/extendedmatrix" {...ext}>Zenodo ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="em-footer__legal">
      <span>© {year} E. Demetrescu — CNR-ISPC, Rome</span>
      <span>Content <a href="https://creativecommons.org/licenses/by-nc/4.0/" {...ext}>CC BY-NC 4.0</a> · code GPL-3.0 unless noted</span>
      <a href={`${B}/privacy`}>Privacy</a>
      <a href={`${B}/privacy#cookies`}>Cookies</a>
      <a href={`${B}/ai-usage`}>AI usage</a>
      <a href={`${B}/stats`}>Site statistics</a>
      <a href={`${B}/status.json`}>status.json</a>
    </div>
  </div>
</footer>

<style>
  .em-footer { background: var(--em-bg-warm); border-top: 1px solid var(--em-border); padding: 48px 0 28px; margin-top: 80px; }
  .em-footer__inner { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter); }
  .em-footer__cols { display: grid; grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr)); gap: 28px; }
  .em-footer__brand { display: inline-flex; align-items: center; gap: 9px; color: var(--em-navy); font: 700 1.05rem/1 var(--font-display); }
  .em-footer__brand span span { font-weight: 400; }
  .em-footer__brand svg { width: 16px; height: auto; }
  .em-footer__about p { margin-top: 12px; font-size: 0.86rem; color: var(--em-text-muted); max-width: 30ch; line-height: 1.6; }
  .em-footer h2 { font: 600 0.7rem var(--font-sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--em-text-faint); margin-bottom: 10px; }
  .em-footer ul { list-style: none; display: grid; gap: 7px; font-size: 0.88rem; }
  .em-footer ul a { color: var(--em-navy); }
  .em-footer__legal { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--em-border); display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 0.78rem; color: var(--em-text-faint); }
  .em-footer__legal a { color: var(--em-text-muted); text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 860px) { .em-footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } .em-footer__about { grid-column: 1 / -1; } }
</style>
