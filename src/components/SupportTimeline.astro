---
/**
 * Support windows of the EM lines, drawn to one time scale (audit V1):
 * release → end of support, the Blender pin beside each bar, a dashed line
 * for today. Dates come from the versions collection; nothing is typed here.
 */
import { getCollection } from 'astro:content';
interface Props { variant?: 'band' | 'page'; rows?: number }
const { variant = 'page', rows } = Astro.props;
const all = (await getCollection('versions')).sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));
// Lines older than the dated ones: their year comes from the software
// deposit on Zenodo listed in the publications ("ExtendedMatrix v.1.1.0").
const softwareYear = new Map<string, number>();
for (const p of await getCollection('publications')) {
  const m = /ExtendedMatrix v\.?(\d+\.\d+)/i.exec(String((p.data as any).title ?? ''));
  if (m && (p.data as any).year) softwareYear.set(m[1], Number((p.data as any).year) + 0.5);
}
const yr = (d: Date) => d.getFullYear() + (d.getMonth() + d.getDate() / 31) / 12;
const now = new Date();
const today = yr(now);
// a line without its own release date starts where it is announced; one without an end runs to its successor
const list = all.map((v, i) => {
  const d = v.data;
  const start = d.releaseDate ? yr(d.releaseDate) : d.status === 'development' ? (all.find((x) => x.data.releaseDate && x.data.status !== 'development')?.data.releaseDate ? yr(all.find((x) => x.data.releaseDate && x.data.status !== 'development')!.data.releaseDate!) : today) : softwareYear.get(d.version) ?? (d.flagPaper?.year ? d.flagPaper.year + 0.5 : 2015.5);
  const newer = all.slice(0, i).reverse().find((x) => x.data.releaseDate);
  const newerStart = newer?.data.releaseDate ? yr(newer.data.releaseDate) : undefined;
  const nextOlder = all[i - 1];
  const nextStart = nextOlder && nextOlder.data.status !== 'development'
    ? (nextOlder.data.releaseDate ? yr(nextOlder.data.releaseDate) : softwareYear.get(nextOlder.data.version)) : undefined;
  const ms = (d.milestones ?? []).slice().sort((a, b) => +a.date - +b.date);
  // phases of a line in development: dev → alpha → beta → stable
  const phases = d.status === 'development' && ms.length
    ? [{ k: 'dev', from: start, to: yr(ms[0].date) }, ...ms.filter((m) => m.phase !== 'stable').map((m, j) => ({ k: m.phase, from: yr(m.date), to: yr((ms[ms.indexOf(m) + 1] ?? m).date) }))]
    : [];
  const stableAt = ms.find((m) => m.phase === 'stable');
  const open = d.status !== 'development' && !d.eolDate; // end of support never declared
  const end = d.status === 'development' ? (stableAt ? yr(stableAt.date) : null) : d.eolDate ? yr(d.eolDate) : Math.min((nextStart ?? newerStart ?? today) + 1.2, today);
  const state = d.status === 'development' ? 'dev' : d.eolDate && d.eolDate >= now ? 'lts' : 'old';
  const pin = d.blenderLts ? `Blender ${d.blenderLts} LTS` : d.blenderMin ? `Blender ${d.blenderMin}+` : '';
  const fmt = (x: Date) => x.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
  const span = open ? `released ${Math.floor(start)}` : phases.length ? ['development from ' + Math.floor(start), ...ms.map((m) => `${m.phase} ${fmt(m.date)}${m.note ? ` (${m.note})` : ''}`)].join(' · ') : `${Math.floor(start)}–${end === null ? 'in development' : state === 'lts' ? `supported to ${d.eolDate!.getFullYear()}` : Math.floor(end)}`;
  return { v: d.version, start, end, state, pin, span, open, phases, stable: stableAt ? yr(stableAt.date) : null };
}).slice(0, rows ?? 99);
const x0 = 2015, x1 = 2029.6, W = 900, L = 70, R = 120, H = 28;
const X = (t: number) => L + ((t - x0) / (x1 - x0)) * (W - L - R);
const h = list.length * H + 36;
const PH: Record<string, string> = { dev: 'dev', alpha: 'α', beta: 'β' };
const years = Array.from({ length: 15 }, (_, i) => 2015 + i);
---
<div class={`tl tl--${variant}`}>
  <svg viewBox={`0 0 ${W} ${h}`} role="img" aria-label="Support window of each Extended Matrix line, from release to end of support">
    <defs><linearGradient id={`fade-${variant}`} x1="0" x2="1" y1="0" y2="0"><stop class="fs0" offset="0" /><stop class="fs1" offset="0.55" /><stop class="fs2" offset="1" /></linearGradient></defs>
    {years.map((y) => (<g><line class="gr" x1={X(y)} x2={X(y)} y1="6" y2={h - 22} /><text class="ax" x={X(y)} y={h - 8} text-anchor="middle">{y}</text></g>))}
    {list.map((r, i) => {
      const y = 10 + i * H; const e = r.end ?? x1 - 0.1;
      return (<g>
        <text class="lb" x={L - 12} y={y + H / 2 + 3} text-anchor="end">EM {r.v}</text>
{r.phases.length ? (<g>
          {r.phases.map((ph) => (<g>
            <rect class={`b-dev ph-${ph.k}`} x={X(ph.from)} y={y + 6} width={Math.max(2, X(ph.to) - X(ph.from) - 1.5)} height={H - 12} rx="3"><title>EM {r.v} · {r.span}</title></rect>
            <text class="phl" x={(X(ph.from) + X(ph.to)) / 2} y={y + H / 2 + 3} text-anchor="middle">{PH[ph.k]}</text>
          </g>))}
          {r.stable && <g><path class="ph-st" d={`M${X(r.stable)} ${y + 4} l6 ${H / 2 - 4} l-6 ${H / 2 - 4} l-6 ${-(H / 2 - 4)} z`}><title>EM {r.v} stable · planned</title></path></g>}
        </g>) :         (<rect class={`b-${r.state}`} style={r.open ? `fill:url(#fade-${variant})` : undefined} x={X(r.start)} y={y + 6} width={Math.max(4, X(e) - X(r.start))} height={H - 12} rx="3"><title>EM {r.v} · {r.span}{r.pin ? ` · ${r.pin}` : ''}</title></rect>)}
        {r.pin && <text class="pin" x={X(e) + (r.stable ? 12 : 6)} y={y + H / 2 + 3}>{r.pin}</text>}
      </g>);
    })}
    <line class="now" x1={X(today)} x2={X(today)} y1="2" y2={h - 22} />
    <text class="nowt" x={X(today) + 5} y={h - 26}>today</text>
  </svg>
</div>
<style>
  .tl { overflow-x: auto; }
  .tl svg { display: block; min-width: 600px; width: 100%; height: auto; }
  .tl .ax { font: 10px var(--font-mono); }
  .tl .lb { font: 600 11px var(--font-sans); }
  .tl .pin { font: 9.5px var(--font-mono); }
  .tl .nowt { font: 600 10px var(--font-sans); }
  .tl .now { stroke-width: 1.4; stroke-dasharray: 3 3; }
  .tl--page .ax, .tl--page .pin { fill: var(--em-text-faint); }
  .tl--page .gr { stroke: var(--em-border); }
  .tl--page .lb, .tl--page .nowt { fill: var(--em-text); }
  .tl--page .now { stroke: var(--em-text); }
  .tl--page .b-lts { fill: var(--em-gold); }
  .tl--page .b-dev { fill: var(--em-navy); opacity: 0.35; }
  .tl--page .b-old { fill: var(--em-text-faint); opacity: 0.35; }
  .tl--band .ax { fill: #9fb7d3; }
  .tl--band .gr { stroke: rgba(255, 255, 255, 0.1); }
  .tl--band .pin { fill: #9fb7d3; }
  .tl--page .fs0, .tl--page .fs1 { stop-color: var(--em-text-faint); } .tl--page .fs2 { stop-color: var(--em-text-faint); stop-opacity: 0; }
  .tl--band .fs0, .tl--band .fs1 { stop-color: #9fb7d3; } .tl--band .fs2 { stop-color: #9fb7d3; stop-opacity: 0; }
  .tl .phl { font: 600 9px var(--font-sans); }
  .tl--band .ph-alpha { opacity: .72; } .tl--band .ph-beta { opacity: .9; }
  .tl--band .phl { fill: #0b2440; } .tl--band .ph-st { fill: #e3b43a; }
  .tl--page .ph-alpha { opacity: .55; } .tl--page .ph-beta { opacity: .75; }
  .tl--page .phl { fill: var(--em-text); } .tl--page .ph-st { fill: var(--em-gold); }
  .tl--band .lb, .tl--band .nowt { fill: #eef3f9; }
  .tl--band .now { stroke: #ffffff; }
  .tl--band .b-lts { fill: #e3b43a; }
  .tl--band .b-dev { fill: #a5dcff; opacity: 0.55; }
  .tl--band .b-old { fill: #9fb7d3; opacity: 0.4; }
</style>
