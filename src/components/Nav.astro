---
/**
 * Site navigation. Seven doors, in reading order; the version chip on the
 * right is read from the release manifest (src/lib/releases.ts), so it
 * changes on its own the day a new line becomes the recommended one.
 * Versions and the developer tracker live in the footer and in the chip.
 */
import { manifesto } from '../lib/releases';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(B, '') || '/';
const m = await manifesto();
const rec = m.recommended;
const items: Array<[string, string]> = [
  ['/start', 'Learn'],
  ['/download', 'Download'],
  ['/projects', 'Projects'],
  ['/publications', 'Publications'],
  ['/standards', 'Standards'],
  ['/community', 'Community'],
];
const on = (p: string) => here === p || here.startsWith(p + '/');
---

<nav class="em-nav" aria-label="Main">
  <div class="em-nav__inner">
    <a href={`${B}/`} class="em-nav__brand" aria-label="Extended Matrix home">
      <svg class="em-nav__mark" viewBox="0 0 140 240" width="18" height="31" aria-hidden="true"><use href="#mark" /></svg>
      <span class="em-nav__wordmark">Extended<span>Matrix</span></span>
    </a>

    <button type="button" class="em-nav__burger" aria-label="Open menu" aria-expanded="false"
            aria-controls="em-nav-menu" data-em-burger>
      <span class="em-nav__burger-bar"></span><span class="em-nav__burger-bar"></span><span class="em-nav__burger-bar"></span>
    </button>

    <ul id="em-nav-menu" class="em-nav__links" data-em-menu>
      {items.map(([p, l]) => (
        <li><a href={`${B}${p}`} aria-current={on(p) ? 'page' : undefined}>{l}</a></li>
      ))}
      <li><a href="https://docs.extendedmatrix.org" target="_blank" rel="noopener">Docs<span aria-hidden="true"> ↗</span></a></li>
      {rec && (
        <li class="em-nav__chip-li">
          <a class="em-nav__chip" href={`${B}/versions/${rec.slug}/`} title="The recommended line, read from the release manifest">
            <i aria-hidden="true"></i>EM {rec.version} LTS
          </a>
        </li>
      )}
      <li class="em-nav__icons">
        <button type="button" class="em-nav__icon em-nav__theme" data-em-theme aria-label="Theme: follows the system" title="Theme: follows the system">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5v17" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" stroke="none"/></svg>
        </button>
        <a href={`${B}/code`} class="em-nav__icon" aria-label="Extended Matrix code map — repositories on GitHub" title="Code map">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.4.5 0 5.9 0 12.5c0 5.3 3.4 9.8 8.2 11.4.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.4-1.3-5.4-5.9 0-1.3.5-2.4 1.3-3.2-.1-.3-.6-1.6.1-3.3 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.3 3 .1 3.3.8.9 1.3 2 1.3 3.2 0 4.6-2.7 5.6-5.4 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.8-1.6 8.2-6.2 8.2-11.4C24 5.9 18.6.5 12 .5z"/>
          </svg>
          <span class="em-nav__icon-label">Code</span>
        </a>
        <a href="https://t.me/UserGroupEM" target="_blank" rel="noopener" class="em-nav__icon" aria-label="Extended Matrix on Telegram" title="Telegram">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0Zm4.962 7.224c.1-.002.321.023.466.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212-.07-.062-.174-.041-.249-.024-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.009-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          <span class="em-nav__icon-label">Telegram</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  // Theme: follows the system → light → dark → follows the system.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-em-theme]');
  if (themeBtn) {
    const label = (t: string | undefined) => `Theme: ${t === 'light' ? 'light' : t === 'dark' ? 'dark' : 'follows the system'}`;
    const apply = (t: string | undefined) => {
      if (t) document.documentElement.dataset.theme = t; else delete document.documentElement.dataset.theme;
      try { t ? localStorage.setItem('em-theme', t) : localStorage.removeItem('em-theme'); } catch { /* storage blocked */ }
      themeBtn.setAttribute('aria-label', label(t)); themeBtn.title = label(t);
    };
    themeBtn.setAttribute('aria-label', label(document.documentElement.dataset.theme)); themeBtn.title = label(document.documentElement.dataset.theme);
    themeBtn.addEventListener('click', () => {
      const cur = document.documentElement.dataset.theme;
      apply(cur === undefined ? 'light' : cur === 'light' ? 'dark' : undefined);
    });
  }

  const burger = document.querySelector<HTMLButtonElement>('[data-em-burger]');
  const menu = document.querySelector<HTMLUListElement>('[data-em-menu]');
  if (burger && menu) {
    const close = () => {
      burger.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
      document.body.classList.remove('em-nav-locked');
    };
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      if (open) { close(); return; }
      burger.setAttribute('aria-expanded', 'true');
      menu.classList.add('is-open');
      document.body.classList.add('em-nav-locked');
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }
</script>

<style is:global>
  body.em-nav-locked { overflow: hidden; }
</style>

<style>
  .em-nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--em-bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--em-border);
  }
  .em-nav__inner {
    max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter);
    display: flex; align-items: center; gap: 20px; height: 64px;
  }
  .em-nav__brand { display: flex; align-items: center; gap: 10px; color: var(--em-navy); flex: none; }
  .em-nav__brand:hover { color: var(--em-navy); }
  .em-nav__mark { width: 18px; height: auto; }
  .em-nav__wordmark { font: 700 1.12rem/1 var(--font-display); letter-spacing: -0.01em; white-space: nowrap; }
  .em-nav__wordmark span { font-weight: 400; }
  .em-nav__links { display: flex; align-items: center; gap: 2px; list-style: none; margin-left: auto; }
  .em-nav__links > li > a:not(.em-nav__chip):not(.em-nav__icon) {
    display: block; padding: 8px 10px; border-radius: 6px; font-size: 0.88rem; color: var(--em-text-muted);
  }
  .em-nav__links > li > a:not(.em-nav__chip):not(.em-nav__icon):hover { color: var(--em-text); background: var(--em-bg-warm); }
  .em-nav__links a[aria-current='page'] { color: var(--em-navy) !important; font-weight: 600; box-shadow: inset 0 -2px 0 var(--em-gold); border-radius: 0 !important; }
  .em-nav__chip {
    display: inline-flex; align-items: center; gap: 7px; margin-left: 8px;
    border: 1px solid var(--em-border-strong); border-radius: 999px; padding: 4px 11px 4px 9px;
    font: 500 0.74rem var(--font-mono); color: var(--em-text); background: var(--em-surface); white-space: nowrap;
  }
  .em-nav__chip i { width: 7px; height: 7px; border-radius: 50%; background: var(--em-gold); }
  .em-nav__chip:hover { border-color: var(--em-navy); color: var(--em-navy); }
  .em-nav__icons { display: flex; gap: 4px; margin-left: 8px; }
  .em-nav__icon { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 6px; color: var(--em-text-muted); }
  .em-nav__theme { border: 0; background: none; cursor: pointer; }
  .em-nav__icon:hover { color: var(--em-navy); background: var(--em-bg-warm); }
  .em-nav__icon-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .em-nav__burger { display: none; margin-left: auto; width: 42px; height: 42px; border: 1px solid var(--em-border-strong); background: var(--em-surface); border-radius: 6px; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
  .em-nav__burger-bar { display: block; width: 18px; height: 2px; background: var(--em-navy); border-radius: 1px; }

  @media (max-width: 1020px) {
    .em-nav__burger { display: inline-flex; }
    .em-nav__links {
      display: none; position: fixed; top: 64px; left: 0; right: 0; z-index: 49;
      /* an explicit height: the header's blur makes IT the containing block of
         this fixed panel, so `bottom: 0` would end the panel at the header's foot */
      height: calc(100vh - 64px); height: calc(100dvh - 64px);
      flex-direction: column; align-items: stretch; gap: 0; margin: 0;
      padding: 12px var(--gutter) 32px; background: var(--em-surface); overflow-y: auto;
    }
    .em-nav__links.is-open { display: flex; }
    .em-nav__links > li > a:not(.em-nav__chip):not(.em-nav__icon) { padding: 14px 4px; border-bottom: 1px solid var(--em-border); border-radius: 0; font-size: 1rem; }
    .em-nav__links a[aria-current='page'] { box-shadow: inset 3px 0 0 var(--em-gold); padding-left: 12px !important; }
    .em-nav__chip-li { padding: 16px 0 4px; }
    .em-nav__chip { margin-left: 0; }
    .em-nav__icons { margin: 8px 0 0; }
  }
</style>
