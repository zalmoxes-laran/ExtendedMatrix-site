---
/**
 * All versions (audit V1, V2): a support timeline drawn to scale above a
 * plain list. The state of each line comes from the manifest, computed
 * from its dates.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SupportTimeline from '../../components/SupportTimeline.astro';
import { manifesto, meseAnno } from '../../lib/releases';

const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = (await getCollection('versions')).sort((a, b) => b.data.order - a.data.order);
const m = await manifesto();
const st = (slug: string) => m.lines.find((l) => l.slug === slug);
---

<BaseLayout title="Versions" description="Every Extended Matrix release: the recommended Long-Term Support line, the legacy line still supported, the development line and the archive.">
  <section class="vh">
    <div class="container">
      <span class="tag">All versions</span>
      <h1>Every Extended Matrix release.</h1>
      <p class="sub">Two lines run in parallel: a Long-Term Support line for production and a development line for what comes next. Older releases stay available for projects that need to be reopened.</p>
      <div class="tlbox"><SupportTimeline variant="page" /></div>
    </div>
  </section>
  <section class="vbody">
    <div class="container">
      <ul class="vlist">
        {all.map((v) => {
          const slug = v.id.replace(/\.md$/, '');
          const l = st(slug);
          const d = v.data;
          const meta = [
            d.releaseDate ? `Released ${meseAnno(d.releaseDate.toISOString().slice(0, 10))}` : l?.state === 'dev' ? 'No release date yet' : null,
            d.blenderLts ? `Blender ${d.blenderLts} LTS` : d.blenderMin ? `Blender ${d.blenderMin}+` : d.usesYed ? 'yEd 3.21+' : null,
            d.eolDate ? `Supported to ${meseAnno(d.eolDate.toISOString().slice(0, 10))}` : null,
          ].filter(Boolean);
          return (
            <li>
              <a class="vrow" href={`${B}/versions/${slug}/`}>
                <span class="vn">{d.version}</span>
                <div>
                  <b>{d.title}{l && <span class={`badge badge--${l.state}`}>{l.label}</span>}</b>
                  <p>{d.summary}</p>
                </div>
                <div class="meta">{meta.map((x) => <span>{x}</span>)}</div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .vh { padding: clamp(40px, 6vw, 64px) 0 24px; }
  .vh h1 { font-size: clamp(2rem, 4.6vw, 3.1rem); margin-top: 16px; }
  .sub { color: var(--em-text-muted); max-width: 62ch; margin-top: 12px; }
  .tlbox { margin-top: 28px; border: 1px solid var(--em-border); border-radius: var(--radius-lg); background: var(--em-surface); padding: 16px; }
  .vbody { padding-bottom: 24px; }
  .vlist { list-style: none; border-top: 1px solid var(--em-border); margin-top: 12px; }
  .vrow { display: grid; grid-template-columns: 90px minmax(0, 1fr) 230px; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--em-border); align-items: baseline; color: var(--em-text); }
  .vrow:hover b { color: var(--em-navy); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) { .vrow { grid-template-columns: minmax(0, 1fr); gap: 6px; } }
  .vn { font: 700 1.6rem var(--font-display); color: var(--em-navy); }
  .vrow b { font-weight: 600; font-size: 1.02rem; }
  .vrow p { font-size: 0.9rem; color: var(--em-text-muted); margin-top: 4px; line-height: 1.55; }
  .meta { display: grid; gap: 2px; font: 0.76rem/1.6 var(--font-mono); color: var(--em-text-faint); }
  .badge { font: 600 0.62rem var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase; border-radius: 4px; padding: 3px 6px; margin-left: 10px; vertical-align: 2px; background: var(--em-bg-warm); color: var(--em-text-muted); border: 1px solid var(--em-border); white-space: nowrap; }
  .badge--recommended { background: var(--em-gold); color: var(--em-charcoal); border-color: var(--em-gold); }
  .badge--dev { background: var(--em-aqua); color: var(--em-navy); border-color: var(--em-aqua); }
</style>
