---
/**
 * Download. Choose a line, then take what your work needs (audit D1–D5).
 * Lines, states, dates and versions all come from the release manifest;
 * the three tables are rendered at build time and the selector only shows
 * one of them. `?line=1-6` and `?role=modeller` open the page on a choice.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ComponentTable from '../components/ComponentTable.astro';
import { manifesto, meseAnno } from '../lib/releases';

const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = await manifesto();
const shown = ['recommended', 'dev', 'legacy'];
const lines = m.lines.filter((l) => shown.includes(l.state)).sort((a, b) => shown.indexOf(a.state) - shown.indexOf(b.state));
const first = lines[0];
const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
const blender = (l: typeof first) => (l.blenderLts ? `${l.blenderLts} LTS` : l.blenderMin ? `${l.blenderMin}+` : '—');
---

<BaseLayout
  title="Download"
  description="Download Extended Matrix: choose a line (LTS or development) and get the yEd palette, EMStudio, EM Tools for Blender, s3dgraphy and the rest of the framework."
>
  <section class="dl-head">
    <div class="container">
      <span class="tag">Download</span>
      <h1>Get Extended Matrix.</h1>
      <p class="sub">Choose a line, then take what your work needs. Every version number on this page is read from where the tool is published.</p>

      <div class="lsel" role="radiogroup" aria-label="EM line" data-lsel>
        {lines.map((l) => (
          <button type="button" role="radio" class="lopt" data-line={l.slug} aria-checked={l === first ? 'true' : 'false'}>
            <b>EM {l.version}</b>
            <span>{l.state === 'recommended' ? 'Recommended · LTS' : l.state === 'dev' ? 'In development' : `Legacy · to ${meseAnno(l.eolDate)}`}</span>
          </button>
        ))}
      </div>

      {lines.map((l) => (
        <div class="lsum" data-line-panel={l.slug} hidden={l !== first}>
          <div>
            <p>{l.summary}</p>
            {l.state === 'dev' && m.recommended && (
              <p class="banner"><b>{l.version} is a development line.</b> Builds are real and installable; formats can still change before the release. For production work use <a href={`${B}/download/?line=${m.recommended.slug}`} data-line-link={m.recommended.slug}>EM {m.recommended.version} LTS</a>.</p>
            )}
            {l.state === 'legacy' && m.recommended && (
              <p class="banner banner--gold"><b>For projects already authored on {l.version}.</b> New projects start from <a href={`${B}/download/?line=${m.recommended.slug}`} data-line-link={m.recommended.slug}>EM {m.recommended.version}</a>.</p>
            )}
            <p class="prereq">
              <span><b>Blender</b> <i>{blender(l)}</i></span>
              {l.yed ? <span><b>yEd</b> <i>{l.yed.replace(/^yEd /, '')}</i></span> : <span><b>Editor</b> <i>EMStudio, below</i></span>}
            </p>
          </div>
          <dl>
            <dt>Status</dt><dd>{l.label}</dd>
            {l.releaseDate && <><dt>Released</dt><dd>{l.releaseDate}</dd></>}
            {l.eolDate && <><dt>Supported to</dt><dd>{l.eolDate}</dd></>}
            {l.docsUrl && <><dt>Manual</dt><dd><a href={l.docsUrl} target="_blank" rel="noopener">{l.docsUrl.replace('https://', '').replace(/\/$/, '')}</a></dd></>}
            <dt>Release page</dt><dd><a href={`${B}/versions/${l.slug}/`}>EM {l.version} →</a></dd>
          </dl>
        </div>
      ))}
    </div>
  </section>

  <section class="dl-body">
    <div class="container">
      <div class="roles" role="group" aria-label="Show what I need as" data-roles>
        <span class="roles__t">Show me what I need as</span>
        {[['all', 'Everyone'], ['archaeologist', 'Archaeologist'], ['modeller', '3D modeller'], ['developer', 'Developer']].map(([k, t]) => (
          <button type="button" class="rchip" data-role={k} aria-pressed={k === 'all' ? 'true' : 'false'}>{t}</button>
        ))}
      </div>
      {lines.map((l) => (
        <div data-line-panel={l.slug} hidden={l !== first}>
          <ComponentTable line={l} />
        </div>
      ))}
      <p class="older">Older lines and their pinned components are on <a href={`${B}/versions/`}>all versions</a>. Add-ons for Blender that are not part of EM are on <a href={`${B}/blender-addons/`}>Blender add-ons</a>.</p>

      <h2 class="all__h">Every tool, one by one</h2>
      <p class="sub">Each component has its own page, repository and manual.</p>
      <ul class="all">
        {tools.map((t) => (
          <li>
            <a href={`${B}/tools/${t.id.replace(/\.md$/, '')}/`}><b>{t.data.name}</b><span>{t.data.role}</span></a>
            <small>{t.data.status !== 'stable' ? t.data.status : t.data.licence}</small>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  const lsel = document.querySelector<HTMLElement>('[data-lsel]');
  const roles = document.querySelector<HTMLElement>('[data-roles]');
  const params = new URLSearchParams(location.search);
  function showLine(slug: string) {
    if (!lsel?.querySelector(`[data-line="${slug}"]`)) return;
    lsel.querySelectorAll<HTMLElement>('[data-line]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.line === slug)));
    document.querySelectorAll<HTMLElement>('[data-line-panel]').forEach((p) => { p.hidden = p.dataset.linePanel !== slug; });
  }
  function showRole(role: string) {
    roles?.querySelectorAll<HTMLElement>('[data-role]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.role === role)));
    document.querySelectorAll<HTMLElement>('.ct__row').forEach((r) => {
      const rs = (r.dataset.roles ?? '').split(' ');
      r.classList.toggle('is-dim', role !== 'all' && !rs.includes(role) && !rs.includes('core'));
    });
  }
  lsel?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-line]');
    if (b) { showLine(b.dataset.line!); history.replaceState(null, '', `?line=${b.dataset.line}`); }
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-line-link]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); showLine(a.dataset.lineLink!); }));
  roles?.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-role]'); if (b) showRole(b.dataset.role!); });
  if (params.get('line')) showLine(params.get('line')!);
  if (params.get('role')) showRole(params.get('role')!);
</script>

<style>
  .dl-head { padding: clamp(40px, 6vw, 64px) 0 8px; }
  .dl-head h1 { font-size: clamp(2rem, 4.6vw, 3.1rem); margin-top: 16px; }
  .sub { color: var(--em-text-muted); max-width: 62ch; margin-top: 12px; }
  .lsel { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
  .lopt { display: grid; gap: 2px; text-align: left; border: 1px solid var(--em-border-strong); background: var(--em-surface); border-radius: 10px; padding: 10px 18px 11px; cursor: pointer; color: var(--em-text); min-width: 180px; font: inherit; }
  .lopt b { font: 700 1.08rem var(--font-display); color: var(--em-navy); }
  .lopt span { font-size: 0.78rem; color: var(--em-text-muted); }
  .lopt[aria-checked='true'] { border-color: var(--em-gold); box-shadow: inset 0 0 0 1px var(--em-gold); background: var(--em-gold-tint); }
  .lsum { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 28px; margin-top: 22px; padding: 24px; border: 1px solid var(--em-border); border-radius: var(--radius-lg); background: var(--em-surface); }
  .lsum[hidden] { display: none; }
  @media (max-width: 760px) { .lsum { grid-template-columns: minmax(0, 1fr); } }
  .lsum p { color: var(--em-text-muted); font-size: 0.94rem; }
  .lsum dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; font-size: 0.86rem; align-content: start; }
  .lsum dt { color: var(--em-text-faint); }
  .lsum dd { font-family: var(--font-mono); font-size: 0.82rem; overflow-wrap: anywhere; }
  .banner { margin-top: 14px; padding: 12px 16px; border-radius: 10px; background: var(--em-aqua); color: var(--em-text) !important; font-size: 0.9rem !important; }
  .banner--gold { background: var(--em-gold-tint); }
  .banner a { font-weight: 600; text-decoration: underline; }
  .prereq { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
  .prereq span { display: inline-flex; gap: 8px; align-items: center; border: 1px solid var(--em-border); border-radius: 999px; padding: 4px 12px; font-size: 0.84rem; background: var(--em-bg); color: var(--em-text); }
  .prereq i { font: normal 0.76rem var(--font-mono); color: var(--em-text-faint); }
  .dl-body { padding: 8px 0 24px; }
  .roles { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin: 34px 0 14px; }
  .roles__t { font: 600 0.7rem var(--font-sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--em-text-faint); margin-right: 8px; }
  .rchip { border: 1px solid var(--em-border-strong); background: var(--em-surface); border-radius: 999px; padding: 6px 14px; font: inherit; font-size: 0.84rem; cursor: pointer; color: var(--em-text); }
  .rchip[aria-pressed='true'] { background: var(--em-navy); border-color: var(--em-navy); color: #ffffff; }
  [data-line-panel][hidden] { display: none; }
  .older { margin-top: 18px; font-size: 0.9rem; color: var(--em-text-muted); }
  .older a { text-decoration: underline; text-underline-offset: 2px; }
  .all__h { margin-top: 64px; font-size: 1.5rem; }
  .all { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0 28px; margin-top: 18px; border-top: 1px solid var(--em-border); }
  .all li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--em-border); }
  .all a { display: grid; }
  .all b { font-weight: 600; }
  .all span { font-size: 0.8rem; color: var(--em-text-muted); }
  .all small { font: 0.72rem var(--font-mono); color: var(--em-text-faint); white-space: nowrap; }
</style>
