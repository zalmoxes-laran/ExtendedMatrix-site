---
/**
 * Home. Eight sections in reading order (audit H4):
 *   thesis (a real matrix) → reading key → three doors → four views →
 *   projects → release status → standards & the long run → cite & reuse → news.
 * One ochre action per view. Numbers and states come from the manifest.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMatrix from '../components/HeroMatrix.astro';
import Glyph from '../components/Glyph.astro';
import Doors from '../components/Doors.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import ReleaseBand from '../components/ReleaseBand.astro';
import { manifesto, meseAnno } from '../lib/releases';
import home3dViewport from '../assets/home/3d-viewport-proxies.png';
import homeEmGraph from '../assets/home/em-graph.png';
import homeStratigraphyTree from '../assets/home/stratigraphy-tree.png';
import homeHeriverse from '../assets/home/heriverse-collaborative.png';

const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = await manifesto();
const rec = m.recommended;
const dev = m.dev;

const partners = (await getCollection('partners')).filter((p) => p.data.logo).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// Projects: one cover per project (audit H3), most recent first among the featured.
const projects = (await getCollection('projects', (p) => !p.data.draft && (p.data.cover || p.data.coverUrl)))
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const projectCount = (await getCollection('projects', (p) => !p.data.draft)).length;
const firstYear = Math.min(...projects.map((p) => p.data.year ?? 9999));
const shown = projects.slice(0, 6);

const LIVE = 'https://strativerse-test.ispc.cnr.it/a/heriverse/?scene=scene%3Ae3bdd326-13cb-4489-a062-e035ede2563c';
const views = [
  { t: '3D viewport', s: 'Proxies on the photogrammetric model, coloured by epoch.', img: home3dViewport, alt: 'Blender 3D viewport showing semi-transparent proxy boxes over a photogrammetric model' },
  { t: 'Stratigraphic graph', s: 'The matrix itself, with its paradata groups.', img: homeEmGraph, alt: 'Extended Matrix graph with stratigraphic units, properties and document nodes connected by typed edges' },
  { t: 'Data tree', s: 'The same units as a browsable tree in Blender.', img: homeStratigraphyTree, alt: 'EM Tools side panel in Blender with the tree of units, documents, extractions and properties' },
  { t: 'Heriverse', s: 'The published scene, open to anyone with a browser.', img: homeHeriverse, alt: 'Heriverse web scene with a reconstruction, a paradata pop-up and collaborators' },
];
const foundation = (await getCollection('versions')).find((v) => v.data.flagPaper?.isFoundation)?.data.flagPaper;
---

<BaseLayout title="Extended Matrix">
  <!-- 1 · thesis -->
  <section class="hero">
    <div class="container hero__in">
      <div class="hero__copy">
        <span class="tag">A formal language for archaeological reasoning</span>
        <h1>Every reconstruction, traceable to its <em>evidence</em>.</h1>
        <p class="hero__lede">
          Extended Matrix records what was found, how it was read, and where a
          reconstruction goes beyond the data. One stratigraphic graph that
          people read and machines process.
        </p>
        <div class="hero__acts">
          <a href={`${B}/start`} class="btn btn-gold">Start here</a>
          {rec && <a href={`${B}/download/`} class="btn btn-ghost">Download EM {rec.version} LTS</a>}
        </div>
        <p class="hero__rel">
          {rec && <span><b>{rec.version} LTS</b> supported to {meseAnno(rec.eolDate)}</span>}
          {dev && <span><b>{dev.version}</b> in development</span>}
          <span>Open source · GPL-3.0</span>
        </p>
      </div>
      <HeroMatrix />
    </div>
  </section>

  <!-- 2 · reading key -->
  <div class="key" aria-label="Reading key">
    <div class="container key__in">
      <span class="key__t">Reading key</span>
      <span><Glyph name="US" /><b>US</b> what was found</span>
      <span><Glyph name="USVs" /><b>USVs</b> rebuilt, structural</span>
      <span><Glyph name="USVn" /><b>USVn</b> rebuilt, by typology</span>
      <span><Glyph name="SF" /><b>SF</b> special find</span>
      <span><Glyph name="doc" /><b>D</b> document</span>
      <span><Glyph name="ext" w={18} h={18} /><b>E</b> extractor</span>
      <span><Glyph name="comb" w={18} h={18} /><b>C</b> combiner</span>
      <span><Glyph name="prop" /><b>P</b> property</span>
    </div>
  </div>

  <!-- 3 · three doors -->
  <section class="sec">
    <div class="container">
      <span class="tag">Three ways in</span>
      <h2>Start from the work you already do.</h2>
      <Doors />
      <p class="sec__after">Not sure which door? <a href={`${B}/find-your-path/`}>Find your path</a> in three questions.</p>
    </div>
  </section>

  <!-- 4 · four views -->
  <section class="sec sec--ground">
    <div class="container">
      <span class="tag">One graph, four readings</span>
      <h2>The same data, wherever you look at it.</h2>
      <div class="views" data-views>
        <div class="views__tabs" role="tablist" aria-label="Four views of the same EM data">
          {views.map((v, i) => (
            <button class="vtab" role="tab" id={`vt-${i}`} aria-controls={`vp-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="vtab__n">0{i + 1}</span><b>{v.t}</b><span>{v.s}</span>
            </button>
          ))}
        </div>
        <div>
          {views.map((v, i) => (
            <div class="vpanel" role="tabpanel" id={`vp-${i}`} aria-labelledby={`vt-${i}`} hidden={i !== 0}>
              <div class="vimg"><Image src={v.img} alt={v.alt} widths={[640, 960, 1400]} sizes="(min-width: 980px) 66vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} /></div>
              <p class="vcap">
                {i === 3
                  ? <>The live scene opens on request, so this page stays light. <a href={LIVE} target="_blank" rel="noopener">Open the Heriverse scene ↗</a></>
                  : <>Screens from a real case study, authored with EM {rec?.version ?? ''}.</>}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · projects -->
  <section class="sec">
    <div class="container">
      <div class="shead">
        <div>
          <span class="tag">Applied since {firstYear}</span>
          <h2>{projectCount} projects, from Dacia to Rome.</h2>
        </div>
        <a class="more" href={`${B}/projects/`}>All projects <span aria-hidden="true">→</span></a>
      </div>
      <div class="prow">
        {shown.map((p, i) => (
          <a class="pc" href={`${B}/projects/${p.id.replace(/\.md$/, '')}/`}>
            <div class="pc__im">
              {p.data.cover
                ? <Image src={p.data.cover} alt={p.data.coverAlt || p.data.title} widths={[320, 560]} sizes="(min-width: 1000px) 16vw, 45vw" loading={i < 6 ? 'eager' : 'lazy'} />
                : <img src={p.data.coverUrl} alt={p.data.coverAlt || p.data.title} loading="lazy" />}
            </div>
            <b>{p.data.title}</b>
            <span>{p.data.year}{p.data.location ? ` · ${p.data.location}` : ''}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6 · release status -->
  <ReleaseBand />

  <!-- 7 · standards and the long run -->
  <section class="sec">
    <div class="container">
      <span class="tag">Built for the long run</span>
      <h2>A language that research infrastructures can rely on.</h2>
      <div class="trio">
        <div>
          <h3>Open standards</h3>
          <p>The <a href={`${B}/ontology/`}>CRMem ontology</a> extends CIDOC CRM, <a href={`${B}/spec/em-json/`}>em.json</a> carries a study, and the <a href={`${B}/vocab/`}>vocabularies</a> are published in SKOS. Each has a permanent URI and a DOI.</p>
          <a class="more" href={`${B}/standards/`}>The standards <span aria-hidden="true">→</span></a>
        </div>
        <div>
          <h3>Long-Term Support</h3>
          <p>From 1.4 every stable line is maintained for years, so a project that spans several seasons builds on a fixed target. Graphs move forward to the next line without loss.</p>
          <a class="more" href={`${B}/versions/`}>All versions <span aria-hidden="true">→</span></a>
        </div>
        <div>
          <h3>Matured in StratiGraph</h3>
          <p>Between 2025 and 2029 the StratiGraph project, within the European Collaborative Cloud for Cultural Heritage, hardens EM as shared infrastructure: governance, validation, reference exports.</p>
          <a class="more" href={`${B}/about/`}>About the project <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="partners">
        <span class="partners__t">Developed and used with</span>
        <ul>
          {partners.map((p) => (
            <li>{p.data.url
              ? <a href={p.data.url} target="_blank" rel="noopener" title={p.data.name}><PartnerLogo logo={p.data.logo!} logoDark={p.data.logoDark} alt={p.data.logoAlt || p.data.name} /></a>
              : <span title={p.data.name}><PartnerLogo logo={p.data.logo!} logoDark={p.data.logoDark} alt={p.data.logoAlt || p.data.name} /></span>}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 8 · cite and reuse -->
  <section class="sec sec--ground">
    <div class="container">
      <span class="tag">Cite it, reuse it</span>
      <h2>Used EM in a paper? Your readers can follow the chain too.</h2>
      <div class="two">
        <div class="panel">
          <h3>Cite the version you used</h3>
          <p>The 2015 foundation paper is always cited; each release adds the flag paper for the features it introduced. The cite page assembles the list and the BibTeX for your version.</p>
          {foundation?.bibtex && <pre class="bib">{foundation.bibtex.trim()}</pre>}
          <a class="more" href={`${B}/cite/`}>How to cite EM <span aria-hidden="true">→</span></a>
        </div>
        <div class="panel">
          <h3>Open data on Zenodo</h3>
          <p>Reference datasets, training material and case-study graphs go to the Extended Matrix community on Zenodo, each with a DOI. The Great Temple of Sarmizegetusa will be the first complete downloadable case study, with a data paper in <i>Heritage</i>.</p>
          <a class="more" href="https://zenodo.org/communities/extendedmatrix" target="_blank" rel="noopener">Browse the Zenodo community ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9 · news -->
  <section class="sec">
    <div class="container">
      <div class="shead">
        <div><span class="tag">News</span><h2>What is happening in the project.</h2></div>
        <a class="more" href={`${B}/news/`}>All news <span aria-hidden="true">→</span></a>
      </div>
      <div class="news">
        {news.map((n) => (
          <a class="nw" href={`${B}/news/${n.id.replace(/\.md$/, '')}/`}>
            <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
            <b>{n.data.title}</b>
            <p>{n.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-views]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const pick = (i: number) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = i !== j; });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); pick((i + 1) % tabs.length); tabs[(i + 1) % tabs.length].focus(); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); const k = (i + tabs.length - 1) % tabs.length; pick(k); tabs[k].focus(); }
      });
    });
  });
</script>

<style>
  .hero { padding: clamp(40px, 6vw, 76px) 0 clamp(32px, 4vw, 52px); border-bottom: 1px solid var(--em-border); background: var(--em-bg); }
  .hero__in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  @media (max-width: 900px) { .hero__in { grid-template-columns: minmax(0, 1fr); } }
  .hero h1 { font-size: clamp(2.1rem, 4.4vw, 3.35rem); line-height: 1.06; margin-top: 16px; }
  .hero h1 em { font-style: normal; color: var(--em-gold-ink); position: relative; white-space: nowrap; }
  .hero h1 em::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0.04em; height: 0.09em; background: var(--em-gold); border-radius: 2px; transform-origin: left; animation: rule 1.1s 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes rule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) { .hero h1 em::after { animation: none; } }
  .hero__lede { margin-top: 20px; font-size: 1.08rem; color: var(--em-text-muted); max-width: 46ch; }
  .hero__acts { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .hero__rel { margin-top: 18px; display: flex; gap: 6px 16px; flex-wrap: wrap; font-size: 0.82rem; color: var(--em-text-faint); }
  .hero__rel b { color: var(--em-text); font-weight: 600; }
  .btn-gold { color: var(--em-charcoal) !important; }
  .btn-gold:hover { color: var(--em-charcoal) !important; filter: brightness(1.06); }

  .key { background: var(--em-surface); border-bottom: 1px solid var(--em-border); }
  .key__in { display: flex; gap: 8px 22px; flex-wrap: wrap; align-items: center; padding-top: 14px; padding-bottom: 14px; }
  .key__t { font: 600 0.7rem var(--font-sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--em-text-faint); margin-right: 6px; }
  .key span:not(.key__t) { display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--em-text-muted); }
  .key b { color: var(--em-text); font: 600 0.78rem var(--font-mono); }

  .sec { padding: clamp(56px, 7vw, 88px) 0; }
  .sec--ground { background: var(--em-bg-warm); }
  .sec h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); margin-top: 16px; }
  .sec__after { margin-top: 20px; color: var(--em-text-muted); }
  .sec__after a { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .shead { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .more { font-weight: 600; white-space: nowrap; }

  .views { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); gap: 28px; margin-top: 32px; align-items: start; }
  @media (max-width: 860px) { .views { grid-template-columns: minmax(0, 1fr); } }
  .views__tabs { display: grid; gap: 4px; }
  .vtab { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; text-align: left; border: 1px solid transparent; background: transparent; border-radius: 10px; padding: 12px 14px; cursor: pointer; color: var(--em-text); font: inherit; }
  .vtab:hover { background: var(--em-surface); }
  .vtab[aria-selected='true'] { background: var(--em-surface); border-color: var(--em-border); box-shadow: inset 3px 0 0 var(--em-gold); }
  .vtab__n { font: 600 0.72rem var(--font-mono); color: var(--em-gold-ink); grid-row: span 2; padding-top: 3px; }
  .vtab b { font-weight: 600; }
  .vtab span:last-child { font-size: 0.84rem; color: var(--em-text-muted); }
  .vimg { border-radius: 12px; overflow: hidden; border: 1px solid var(--em-border); background: #2b2b2b; aspect-ratio: 16 / 10; }
  .vimg img { width: 100%; height: 100%; object-fit: cover; }
  .vcap { font-size: 0.84rem; color: var(--em-text-faint); margin-top: 10px; }
  .vcap a { font-weight: 600; }

  .prow { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; margin-top: 32px; }
  @media (max-width: 1000px) { .prow { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .prow { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pc { display: grid; gap: 8px; align-content: start; color: var(--em-text); }
  .pc:hover { color: var(--em-navy); }
  .pc__im { aspect-ratio: 4 / 5; border-radius: 10px; overflow: hidden; background: var(--em-bg-warm); }
  .pc__im img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease); }
  .pc:hover img { transform: scale(1.04); }
  .pc b { font-size: 0.88rem; line-height: 1.3; font-weight: 600; }
  .pc span { font: 500 0.72rem var(--font-mono); color: var(--em-text-faint); }

  .trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 32px; }
  @media (max-width: 860px) { .trio { grid-template-columns: minmax(0, 1fr); } }
  .trio > div { display: grid; gap: 10px; align-content: start; }
  .trio h3 { font-size: 1.1rem; }
  .trio p { font-size: 0.92rem; color: var(--em-text-muted); }
  .trio p a { text-decoration: underline; text-underline-offset: 2px; }
  .partners { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--em-border); }
  .partners__t { font: 600 0.7rem var(--font-sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--em-text-faint); }
  .partners ul { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 18px 40px; margin-top: 18px; }
  .partners :global(img) { height: 46px; width: auto; filter: grayscale(1); opacity: 0.8; transition: filter 0.2s, opacity 0.2s; }
  .partners a:hover :global(img) { filter: none; opacity: 1; }
  .partners :global(.logo-d) { filter: none; opacity: 0.9; }

  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 32px; }
  @media (max-width: 760px) { .two { grid-template-columns: minmax(0, 1fr); } }
  .panel { background: var(--em-surface); border: 1px solid var(--em-border); border-radius: var(--radius-lg); padding: 24px; display: grid; gap: 12px; align-content: start; min-width: 0; }
  .panel h3 { font-size: 1.15rem; }
  .panel p { color: var(--em-text-muted); font-size: 0.92rem; }
  .bib { font: 12px/1.55 var(--font-mono); background: var(--em-bg-warm); border: 1px solid var(--em-border); border-radius: 8px; padding: 12px; overflow-x: auto; color: var(--em-text); }

  .news { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 28px; border-top: 1px solid var(--em-border); }
  @media (max-width: 860px) { .news { grid-template-columns: minmax(0, 1fr); } }
  .nw { padding: 20px 24px 22px 0; display: grid; gap: 8px; align-content: start; border-bottom: 1px solid var(--em-border); color: var(--em-text); }
  .nw time { font: 500 0.74rem var(--font-mono); color: var(--em-gold-ink); }
  .nw b { font: 700 1.04rem/1.3 var(--font-display); color: var(--em-navy); }
  .nw p { font-size: 0.88rem; color: var(--em-text-muted); }
  .nw:hover b { text-decoration: underline; text-underline-offset: 3px; }
</style>
