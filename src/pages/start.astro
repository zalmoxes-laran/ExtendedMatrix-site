---
/**
 * Start here (audit S1): one page with the three doors, the fourth for
 * whoever leads a project, and the guided path as the next step. The
 * doors are the same component the home page uses.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Doors from '../components/Doors.astro';
import Glyph from '../components/Glyph.astro';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Start here" description="Pick the door that matches your work: archaeologist, 3D modeller or developer, plus the team roles for whoever leads a project.">
  <section class="sh">
    <div class="container">
      <span class="tag">Start here</span>
      <h1>Pick the door that matches your work.</h1>
      <p class="sub">Extended Matrix is a method (the formal language), a framework (open-source tools) and a community. Each door leads to the first three things to do.</p>
      <Doors />
      <div class="lead4">
        <div class="lead4__g"><Glyph name="br" w={22} h={22} /></div>
        <div>
          <h2>Leading a project or a team?</h2>
          <p>EM projects combine <strong>eight professional figures</strong>: stratigrapher, source hunter, survey specialist, IT specialist, EM drawer, basic and advanced modeller, storyteller. Most teams cover them with two or three people wearing several hats. Naming the figures is what lets a project grow beyond a single researcher.</p>
          <a href={`${B}/personas/`}>See the eight team roles <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="path">
        <div>
          <h2>Not sure yet?</h2>
          <p>Tell us what you have (written sources, drawings, photos, a 3D survey, tables) and what you want to obtain: the guided path shows the tools and the steps.</p>
        </div>
        <a href={`${B}/find-your-path/`} class="btn btn-gold">Find your path</a>
      </div>
      <p class="ask">Questions? <a href="https://t.me/UserGroupEM" target="_blank" rel="noopener">Ask the community on Telegram ↗</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .sh { padding: clamp(40px, 6vw, 64px) 0 24px; }
  .sh h1 { font-size: clamp(2rem, 4.6vw, 3.1rem); margin-top: 16px; }
  .sub { color: var(--em-text-muted); max-width: 62ch; margin-top: 12px; }
  .lead4 { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px; margin-top: 22px; padding: 24px; border: 1px dashed var(--em-border-strong); border-radius: var(--radius-lg); background: var(--em-surface); }
  .lead4 h2, .path h2 { font-size: 1.25rem; }
  .lead4 p, .path p { margin-top: 8px; color: var(--em-text-muted); max-width: 70ch; }
  .lead4 a { display: inline-block; margin-top: 12px; font-weight: 600; }
  .path { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 22px; padding: 28px; border-radius: var(--radius-lg); background: var(--em-gold-tint); }
  .btn-gold { color: var(--em-charcoal) !important; }
  .ask { margin-top: 20px; color: var(--em-text-muted); }
  .ask a { font-weight: 600; }
</style>
